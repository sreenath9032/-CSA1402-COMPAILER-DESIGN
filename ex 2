#include <stdio.h>
#include <string.h>

int main()
{
    char line[500];

    printf("Enter a line: ");
    fgets(line, sizeof(line), stdin);

    /* Check for single-line comment */
    if (strncmp(line, "//", 2) == 0)
    {
        printf("It is a COMMENT.\n");
    }

    /* Check for multi-line comment */
    else if (strncmp(line, "/*", 2) == 0)
    {
        if (strstr(line, "*/") != NULL)
            printf("It is a COMMENT.\n");
        else
            printf("It is an INCOMPLETE COMMENT.\n");
    }

    else
    {
        printf("It is NOT a COMMENT.\n");
    }

    return 0;
}
